# =============================================================================
# ZORA SHOP — Production Backend Environment Variables Template
# Copy this file to `server/.env` and fill in your real credentials.
# NEVER commit the real `server/.env` to source control.
# =============================================================================

# Server Port & Mode
PORT=5000
NODE_ENV=production

# Frontend Client URL (for CORS and credentials)
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL with Prisma)
# Example: postgresql://username:password@localhost:5432/zorashop?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/zorashop?schema=public

# Security & Session Secrets
# Generate random 64-char strings for production
JWT_SECRET=zora_shop_super_secret_production_key_change_in_live
COOKIE_SECRET=zora_shop_cookie_secret_key_change_in_live

# Default Initial Owner (Auto-seeded if no admin exists)
DEFAULT_OWNER_EMAIL=zorashop.homemade@gmail.com
DEFAULT_OWNER_PHONE=+919898014090
DEFAULT_OWNER_NAME=Drashti Bhatt

# Razorpay Payment Gateway
# Obtain keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id_here
RAZORPAY_KEY_SECRET=your_actual_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Real Email Delivery (SMTP)
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=zorashop.homemade@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="ZORA SHOP Homemade Chocolates" <zorashop.homemade@gmail.com>

# Real Mobile SMS Delivery Option A: Fast2SMS (Popular & Quick in India)
# Obtain free/paid API key from https://www.fast2sms.com/
FAST2SMS_API_KEY=

# Real Mobile SMS Delivery Option B: Twilio (Global SMS)
# Obtain credentials from https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Business Integration
# The phone number customer orders link to
WHATSAPP_PHONE=919898014090
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
